@HOST    = {{$dotenv HOST}}
@PORT    = {{$dotenv PORT}}
@baseURL = http://{{HOST}}:{{PORT}}

#== Tests =====================================#

### TEST: Default URL
GET {{baseURL}}/

###

@apiURL = {{baseURL}}/api

### TEST: Default API URL
GET {{apiURL}}/

### TEST: Register user milou
POST {{apiURL}}/auth/register
Content-Type: application/json

{
    "email": "milou@moulinsart.com",
    "password": "woof"
}

### TEST: Login user milou
POST {{apiURL}}/auth/login
Content-Type: application/json

{
    "email": "milou@moulinsart.com",
    "password": "woof"
}

###

@milouToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjZiMDFkZjMwMjU1YzExMTFkMjEzZDg0YSIsImlhdCI6MTc5NTI4NDc4NiwiZXhwIjoxNzk1Mjg4Mzg2fQ.7tHUx4qlsWTBs_URP6QDUOHOfZ1uH6MtRA43qtY8pOU

### TEST: Get all contacts
GET {{apiURL}}/contacts
Authorization: Bearer {{milouToken}}

### TEST: Get all contacts again, with cache
GET {{apiURL}}/contacts
Authorization: Bearer {{milouToken}}

### CRASHTEST: Try to get contacts without the token
GET {{apiURL}}/contacts

### CRASHTEST: Get an unknown contact
GET {{apiURL}}/contacts/polokus
Authorization: Bearer {{milouToken}}

### TEST: Add contact pirlouit
POST {{apiURL}}/contacts
Authorization: Bearer {{milouToken}}
Content-Type: application/json

{
    "name": "pirlouit",
    "age": 25
}

###

@pirlouitID = 6b01d4d36ab11c4682d6a2b7

### TEST: Change nothing about pirlouit
PUT {{apiURL}}/contacts/{{pirlouitID}}
Authorization: Bearer {{milouToken}}
Content-Type: application/json

{
}

### TEST: Change pirlouit's age
PUT {{apiURL}}/contacts/{{pirlouitID}}
Authorization: Bearer {{milouToken}}
Content-Type: application/json

{
    "age": 12
}

### TEST: Change pirlouit's name
PUT {{apiURL}}/contacts/{{pirlouitID}}
Authorization: Bearer {{milouToken}}
Content-Type: application/json

{
    "name": "lutin"
}

### TEST: Recover pirlouit's identity
PUT {{apiURL}}/contacts/{{pirlouitID}}
Authorization: Bearer {{milouToken}}
Content-Type: application/json

{
    "name": "pirlouit",
    "age": 25
}

### TEST: Get newly created contact pirlouit
GET {{apiURL}}/contacts/{{pirlouitID}}
Authorization: Bearer {{milouToken}}

### TEST: Remove contact pirlouit
DELETE {{apiURL}}/contacts/{{pirlouitID}}
Authorization: Bearer {{milouToken}}

### - Check that the contact was removed
GET {{apiURL}}/contacts
Authorization: Bearer {{milouToken}}
